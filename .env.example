# ── Knock Knock Speed Date backend configuration ─────────────────────────────
# Copy to `.env` for local dev. Never commit `.env`.

# Postgres (docker-compose default)
DATABASE_URL=postgres://slide:slide@localhost:5432/slide

# Redis (docker-compose default): OTP TTL, rate limits, doors-open push lock
REDIS_URL=redis://localhost:6379

# JWT signing secret (HS256). Generate: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000000000000000000000

# Access token lifetime (seconds). Default 15m.
ACCESS_TOKEN_TTL_SECS=900
# Refresh token lifetime (seconds). Default 60d.
REFRESH_TOKEN_TTL_SECS=5184000

# OTP config
OTP_TTL_SECS=300
OTP_MAX_ATTEMPTS=5
# Server-side pepper for hashing OTP codes. openssl rand -hex 32
OTP_PEPPER=dev-only-otp-pepper-change-me-000000000000000000000000000000
# Region used to parse a phone number typed without a country code.
DEFAULT_REGION=US

# SMS provider: "console" (dev, prints code to logs) | "sns" | "twilio"
SMS_PROVIDER=console
# Only set true for local/CI smoke tests that need /auth/request-otp to return
# devCode. The API refuses to start if this is true with a real SMS provider.
# With SMS_PROVIDER=console and this false (production today), the client must
# run Firebase phone verification itself. The backend sends no SMS.
EXPOSE_DEV_OTP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# AWS region for SNS (SMS), when SMS_PROVIDER=sns.
AWS_REGION=us-east-1
# Sender ID shown on the SMS where carriers support it (optional).
SMS_SENDER_ID=
# Firebase project id. When set, POST /auth/firebase verifies Firebase phone
# auth ID tokens minted by the iOS client (the "firebase" transport).
FIREBASE_PROJECT_ID=

# Maintained iOS clients use LiveKit for the 5-minute video date. For local
# development, run `livekit-server --dev --bind 0.0.0.0`; dev mode uses this
# key pair. Production must point at the deployed LiveKit WSS endpoint and
# matching keys. Date endpoints return 503 while this is unset.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Server bind
API_BIND=0.0.0.0:8080

RUST_LOG=info,slide_api=debug,slide_sfu=debug,tower_http=debug

# ── Nightly session window (session.rs is the only place that reads these) ──
# Doors open SESSION_OPEN_HOUR:SESSION_OPEN_MINUTE and close
# SESSION_CLOSE_HOUR:SESSION_CLOSE_MINUTE, both local time in SESSION_TZ, every
# day, for everyone (per-user timezone comes later).
SESSION_TZ=America/Los_Angeles
SESSION_OPEN_HOUR=19
SESSION_OPEN_MINUTE=0
SESSION_CLOSE_HOUR=20
SESSION_CLOSE_MINUTE=0
# Dev/CI only: forces the session open at all times, for everyone. Never set
# this in production. Real users only get doors 7-8 PM Pacific.
SESSION_ALWAYS_OPEN=false
# Length of one video date, in seconds. Clamped to 30..900.
DATE_SECONDS=300
# Matching radius in miles. Fixed, not user-adjustable.
MATCH_RADIUS_MILES=75.0

# ── Review accounts ──────────────────────────────────────────────────────────
# App Review must be able to test outside 7-8 PM PT and on one device. Phones
# listed here always see the session as open and pair with each other in the
# lobby regardless of preferences/distance. Comma-separated E.164; empty
# disables review login entirely (so does an empty REVIEW_OTP_CODE).
REVIEW_PHONES=
# Fixed OTP code accepted for the phones above. Empty disables review login.
REVIEW_OTP_CODE=
# The seeded "Sam" demo account review accounts get a match + chat history
# with. See review.rs.
REVIEW_DEMO_PHONE=+16505550199

# ── Push notifications (APNs, standard user-visible alerts only) ────────────
# No CallKit/PushKit/VoIP path exists in this app, so there's only one kind of
# push: a standard alert (banner + sound) for a match, a message, or the
# nightly doors-open notification. All optional for local development: a
# missing key just disables sending (logged, never fatal).
# APNS_KEY_P8 may be the .p8 PEM contents OR a path to the file.
# APNS_TOPIC is the bare bundle id. A trailing ".voip" (the old VoIP-push
# topic, from before CallKit/PushKit were removed) is stripped automatically
# at boot with a warning, so a stale secret can't silently break alert pushes.
# APNS_ENV: sandbox | prod.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_TOPIC=app.exla.slide
APNS_ENV=prod
